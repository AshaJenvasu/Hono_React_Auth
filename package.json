{
  "name": "Hono_Auth",
  "type": "module",
  "scripts": {
    "server": "bun run --hot server/index.ts",
    "client": "cd client && bun run dev",
    "dev": "concurrently \"bun run server\" \"bun run client\" ",
    "db:up": "docker compose up -d",
    "db:generate": "prisma generate",
    "db:migrate": "bunx prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "db:seed": "bunx prisma db seed",
    "open-auth-docs": "open-cli http://localhost:3000/api/auth/reference"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "better-auth": "^1.7.5",
    "hono": "^4.13.8",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "open-cli": "^9.0.0",
    "vite": "^8.3.0"
  }
}
